<?xml version="1.0" encoding="utf-8"?>
<!-- Sent, interior bubble of a group: both spine-side (right) corners tight, outer (left) large. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/bubble_radius_large"
                android:topRightRadius="@dimen/bubble_radius_small"
                android:bottomRightRadius="@dimen/bubble_radius_small"
                android:bottomLeftRadius="@dimen/bubble_radius_large" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
        </shape>
    </item>
</layer-list>
