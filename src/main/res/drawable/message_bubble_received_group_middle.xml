<?xml version="1.0" encoding="utf-8"?>
<!-- Received, interior bubble of a group: both spine-side (left) corners tight, outer (right) large. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/bubble_radius_small"
                android:topRightRadius="@dimen/bubble_radius_large"
                android:bottomRightRadius="@dimen/bubble_radius_large"
                android:bottomLeftRadius="@dimen/bubble_radius_small" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
        </shape>
    </item>
</layer-list>
